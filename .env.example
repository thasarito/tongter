# Used by local sheet-management scripts. The Vite Worker reads .dev.vars.
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
GOOGLE_CREDENTIALS_JSON=
ADMIN_PASSPHRASE=
ADMIN_SESSION_SECRET=
MOCK_SHEET=0

# Optional public LIFF app ID. When present, calendar actions opened through
# a LIFF URL use liff.openWindow(..., external: true).
VITE_LIFF_ID=
