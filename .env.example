# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Public site ----
NEXT_PUBLIC_SITE_URL=https://warissara.thasarito.com

# ---- Google Sheets ----
# The ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# Path to the service account JSON key inside the container. The compose file
# mounts ./secrets/google-service-account.json to this path.
# Remember to share the sheet with the service account's client_email as Editor.
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json

# ---- Admin ----
# Passphrase for /admin. Use something long; it is the only thing protecting the
# guest list and the RSVP dashboard.
ADMIN_PASSPHRASE=

# ---- Serving ----
# The app listens on 172.23.0.1:3200 (see docker-compose.yml) and is fronted by
# the existing Caddy on this box, which terminates TLS for *.thasarito.com via
# the Cloudflare DNS challenge. Nothing to configure here — see README.

# ---- Development ----
# Set to 1 to run against generated fixture data instead of Google Sheets.
# Never enable in production — it replaces the real guest list.
MOCK_SHEET=0
