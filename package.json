{
  "name": "tongterwedding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite dev",
    "dev:worker": "vite dev",
    "build": "vite build",
    "build:worker": "vite build",
    "preview": "vite preview",
    "preview:worker": "vite preview",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts vite.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm check:venue && pnpm check:logic && pnpm check:views && pnpm check:walk && pnpm check:look && pnpm build",
    "sheet": "node --experimental-strip-types scripts/make-sheet.ts",
    "push:sheet": "node --experimental-strip-types scripts/push-to-sheet.ts",
    "check:views": "node --experimental-strip-types scripts/check-views.ts",
    "check:sheets": "node --experimental-strip-types scripts/check-sheets.ts",
    "check:look": "node --experimental-strip-types scripts/check-look.ts",
    "check:walk": "node --experimental-strip-types scripts/check-walk.ts",
    "check:logic": "node --experimental-strip-types scripts/check-logic.ts",
    "check:venue": "node --experimental-strip-types scripts/check-venue.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "hono": "^4.13.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260821.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "exceljs": "^4.4.0",
    "globals": "^17.11.0",
    "googleapis": "^176.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
