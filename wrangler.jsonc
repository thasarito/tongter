{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warissara-wedding",
  "main": "./src/worker/index.ts",
  "preview_urls": true,
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {"not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "routes": [{"pattern": "warissara.thasarito.com/*", "zone_name": "thasarito.com"}],
  "vars": {
    // Requested server-side verifier; the session-signing secret remains separate.
    "ADMIN_PASSPHRASE_HASH": "pbkdf2-sha256$100000$15204728642d1090807d90face0288a0$edc16e8aa677e397542d3c2a356e1dab4d93faf5cf1e3e6c9fdc97b1cda1667e"
  },
  "durable_objects": {"bindings": [{"name":"STUDIO_WRITER","class_name":"StudioSheetWriter","script_name":"warissara-studio-writer"}]},
  "env": {"test": {"durable_objects":{"bindings":[]}}},
  "observability": {"enabled": true}
}
